+import type { TFunction } from 'i18next';
+import type { AuthFileItem, DevinQuotaData, DevinQuotaWindow } from '@/types';
+import {
+  apiClient,
+  createScopedApiRequestConfig,
+  type ApiClientRequestScope,
+} from '@/services/api/client';
+import { isRecord } from '@/utils/helpers';
+import { normalizeAuthIndex } from './parsers';
+import { normalizeIsoTimestampMs, normalizePlanName } from './devinQuota';
+
+export const parseDevinOpenaiQuota = (payload: unknown): DevinQuotaData => {
+  if (!isRecord(payload) || !Array.isArray(payload.groups)) {
+    throw new Error('Invalid Devin OpenAI quota response');
+  }
+  const windows: DevinQuotaWindow[] = [];
+  for (const group of payload.groups) {
+    if (!isRecord(group) || !Array.isArray(group.buckets)) {
+      throw new Error('Invalid Devin OpenAI quota group');
+    }
+    for (const bucket of group.buckets) {
+      if (!isRecord(bucket) || (bucket.window !== 'daily' && bucket.window !== 'weekly')) {
+        throw new Error('Invalid Devin OpenAI quota window');
+      }
+      const fraction = bucket.remainingFraction;
+      if (
+        typeof fraction !== 'number' ||
+        !Number.isFinite(fraction) ||
+        fraction < 0 ||
+        fraction > 1 ||
+        windows.some((window) => window.id === bucket.window)
+      ) {
+        throw new Error('Invalid Devin OpenAI remaining quota');
+      }
+      const resetAtMs =
+        bucket.resetTime === undefined ? null : normalizeIsoTimestampMs(bucket.resetTime);
+      if (bucket.resetTime !== undefined && resetAtMs === null) {
+        throw new Error('Invalid Devin OpenAI quota reset time');
+      }
+      windows.push({
+        id: bucket.window,
+        remainingPercent: fraction * 100,
+        resetAtMs,
+        periodHours: bucket.window === 'daily' ? 24 : 168,
+      });
+    }
+  }
+  if (windows.length !== 2)
+    throw new Error('Devin OpenAI quota response is missing daily or weekly quota');
+  return {
+    windows,
+    observedAtMs: Date.now(),
+    plan: isRecord(payload.subscription) ? normalizePlanName(payload.subscription.plan) : null,
+    planStartMs: null,
+    planEndMs: null,
+  };
+};
+
+export const fetchDevinOpenaiQuota = async (
+  file: AuthFileItem,
+  t: TFunction,
+  requestScope?: ApiClientRequestScope
+): Promise<DevinQuotaData> => {
+  const authIndex = normalizeAuthIndex(file.auth_index ?? file.authIndex);
+  if (!authIndex) throw new Error(t('devin_quota.missing_identity'));
+  const response = await apiClient.post<unknown>(
+    '/plugins/devin-openai/quota',
+    { auth_index: authIndex },
+    requestScope ? createScopedApiRequestConfig(requestScope) : undefined
+  );
+  return parseDevinOpenaiQuota(response);
+};
