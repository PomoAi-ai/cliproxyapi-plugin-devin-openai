+package quotasnapshot
+
+import (
+	"context"
+	"testing"
+)
+
+func TestDevinOpenAIQuotaSnapshotKeepsProviderIdentity(t *testing.T) {
+	service := newQuotaSnapshotTestService(t, 20_000)
+	remaining := 75.0
+	account := AccountTarget{AuthFileSnapshot: "gateway.json", AuthProviderSnapshot: "devin-openai", AuthIndex: "gateway-account"}
+	_, err := service.Write(context.Background(), WriteRequest{Entries: []WriteEntry{{
+		RowKey: "gateway-row", Provider: "devin-openai", Account: account,
+		Windows: []WindowInput{{ProviderWindowID: "devin-openai:daily", WindowKind: "daily", WindowMode: "unknown", ModelScopeKind: "all", Source: "api_query", ObservedAtMS: 19_000, BoundaryAccuracy: "unknown", RemainingPercent: &remaining}},
+	}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := service.Query(context.Background(), QueryRequest{Accounts: []QueryAccount{{RowKey: "gateway-row", Provider: "devin-openai", Account: account}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(result.Items) != 1 || len(result.Items[0].Windows) != 1 {
+		t.Fatalf("missing gateway snapshot: %#v", result)
+	}
+	window := result.Items[0].Windows[0]
+	if window.ProviderWindowID != "devin-openai:daily" || window.RemainingPercent == nil || *window.RemainingPercent != 75 {
+		t.Fatalf("invalid gateway snapshot: %#v", window)
+	}
+	account.AuthProviderSnapshot = "devin"
+	legacy, err := service.Query(context.Background(), QueryRequest{Accounts: []QueryAccount{{RowKey: "legacy-row", Provider: "devin", Account: account}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(legacy.Items) != 1 || len(legacy.Items[0].Windows) != 0 {
+		t.Fatalf("gateway quota leaked into legacy provider: %#v", legacy)
+	}
+}
