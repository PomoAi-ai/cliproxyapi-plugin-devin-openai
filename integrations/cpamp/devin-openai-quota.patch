+import { describe, expect, it } from 'vitest';
+import type { TFunction } from 'i18next';
+import { DEVIN_CONFIG, DEVIN_OPENAI_CONFIG } from '@/components/quota';
+import { buildAccountRows, type AccountQuotaStores } from './accountRows';
+import { buildAccountQuotaDisplayWindows } from './accountQuotaDisplayWindows';
+import { buildAccountQuotaSnapshotQueryAccounts } from './accountQuotaSnapshots';
+import { getQuotaCredentialStoreKey } from '@/utils/quota/credentialScope';
+import type { DevinQuotaData } from '@/types';
+
+describe('Devin OpenAI account quota identity', () => {
+  it('shows independent quota and snapshot identity alongside an existing Devin credential', () => {
+    const plugin = { name: 'gateway.json', type: 'devin-openai', authIndex: 'new-account' };
+    const legacy = { name: 'legacy.json', type: 'devin', authIndex: 'old-account' };
+    const other = { name: 'other.json', type: 'devin-openai', authIndex: 'other-account' };
+    const data: DevinQuotaData = {
+      windows: [
+        { id: 'daily', remainingPercent: 0, resetAtMs: null, periodHours: 24 },
+        { id: 'weekly', remainingPercent: 75, resetAtMs: null, periodHours: 168 },
+      ],
+      observedAtMs: Date.now(),
+      plan: 'Pro',
+      planStartMs: null,
+      planEndMs: null,
+    };
+    const stores: AccountQuotaStores = {
+      antigravityQuota: {},
+      claudeQuota: {},
+      codexQuota: {},
+      kimiQuota: {},
+      metaQuota: {},
+      xaiQuota: {},
+      devinQuota: {
+        [getQuotaCredentialStoreKey(plugin)]: DEVIN_OPENAI_CONFIG.buildSuccessState(data, plugin),
+        [getQuotaCredentialStoreKey(legacy)]: DEVIN_CONFIG.buildSuccessState(
+          { ...data, windows: data.windows.map((window) => ({ ...window, remainingPercent: 50 })) },
+          legacy
+        ),
+      },
+    };
+    const rows = buildAccountRows([plugin, legacy, other], stores);
+    expect(rows.map((row) => row.provider)).toEqual(['devin-openai', 'devin', 'devin-openai']);
+    expect(rows[0].quota.remainingPercent).toBe(0);
+    expect(rows[1].quota.remainingPercent).toBe(50);
+    expect(rows[2].quota.remainingPercent).toBeNull();
+    const windows = buildAccountQuotaDisplayWindows(rows[0], {
+      stores,
+      t: ((key: string) => key) as TFunction,
+      translateQuotaWindowLabel: (_label, key) => key ?? '',
+    });
+    expect(
+      windows.map((window) => ({
+        key: window.key,
+        source: window.source,
+        remaining: window.remainingPercent,
+      }))
+    ).toEqual([
+      { key: 'devin-openai:daily', source: 'devin-openai', remaining: 0 },
+      { key: 'devin-openai:weekly', source: 'devin-openai', remaining: 75 },
+    ]);
+    const accounts = buildAccountQuotaSnapshotQueryAccounts(rows);
+    expect(accounts.map((account) => account.provider)).toEqual([
+      'devin-openai',
+      'devin',
+      'devin-openai',
+    ]);
+    expect(accounts[0].account.auth_provider_snapshot).toBe('devin-openai');
+    expect(accounts[0].account.auth_index).toBe('new-account');
+  });
